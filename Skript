// Der Script prüft, ob eine Internetverbindung vorhanden ist und schalte nach 10 Fehlversuchen den Strom für 15sec ab, um die Fritzbox neu zu starten und damit die Verbindung neu zu initialisieren. 
// Wichtig: Skript auf Run on Startup stellen!
// Ergebnisse des Tests werden an der Konsole ausgegeben.
//


let CONFIG = {
  target: "http://captive.apple.com/hotspot-detect.html", 
  pingInterval: 12000,          // Test-Intervall: 12 Sekunden (Später: 300000)
  failThreshold: 10,            // Test-Schwellenwert: 10 (Später: 18)
  powerOffDuration: 15000       // 15 Sekunden Strom aus
};

let failCount = 0;

function checkInternet() {
  Shelly.call(
    "HTTP.GET",
    { url: CONFIG.target, timeout: 8 }, // Timeout für Test auf 8s (Später gern 20)
    function (result, error_code, error_message) {
      if (error_code !== 0) {
        failCount++;
        // Neue, aufgeräumte Debug-Ausgabe mit Zähler (X/Y)
        print("DEBUG: Internet OFFLINE (" + failCount + "/" + CONFIG.failThreshold + ") - Grund: " + error_message + " (Code: " + error_code + ")");
        
        if (failCount >= CONFIG.failThreshold) {
          print(">>> DEBUG: Rebooting FRITZ!Box... <<<");
          failCount = 0;
          
          Shelly.call("Switch.Set", { id: 0, on: false });
          Timer.set(CONFIG.powerOffDuration, false, function() {
            Shelly.call("Switch.Set", { id: 0, on: true });
          });
        }
      } else {
        // Optionale Ausgabe, wenn es wieder geht
        if (failCount > 0) {
          print("DEBUG: Internet wieder ONLINE. Zähler zurückgesetzt.");
        } else {
          print("DEBUG: Internet ONLINE");
        }
        failCount = 0;
      }
    }
  );
}

print("=== Watchdog Diagnose-Modus gestartet ===");
Timer.set(CONFIG.pingInterval, true, checkInternet);
