// Der Script prüft, ob eine Internetverbindung vorhanden ist und schalte nach 10 Fehlversuchen den Strom für 15sec ab, um die Fritzbox neu zu starten und damit die Verbindung neu zu initialisieren. 
// Wichtig: Skript auf Run on Startup stellen!
// Ergebnisse des Tests werden an der Konsole ausgegeben.
//

let CONFIG = {
  target: "http://1.1.1.1",     // IP-Adresse verhindert DNS-Hänger
  pingInterval: 6000,           // Alle 6 Sekunden testen
  failThreshold: 10,            // Nach 10 Fehlschlägen Reboot
  powerOffDuration: 15000
};

let checkCount = 0;
let failCount = 0;

function checkInternet() {
  checkCount++;
  
  Shelly.call(
    "HTTP.GET",
    { 
      url: CONFIG.target, 
      timeout: 3,
      headers: { "Connection": "close" } // Schließt den Socket sofort nach Antwort
    },
    function (result, error_code) {
      if (error_code !== 0) {
        failCount++;
        print("DEBUG [Check #" + checkCount + "]: Internet OFFLINE (" + failCount + "/" + CONFIG.failThreshold + ")");
        
        if (failCount >= CONFIG.failThreshold) {
          print(">>> DEBUG: Rebooting FRITZ!Box... <<<");
          failCount = 0;
          Shelly.call("Switch.Set", { id: 0, on: false });
          Timer.set(CONFIG.powerOffDuration, false, function() {
            Shelly.call("Switch.Set", { id: 0, on: true });
          });
        }
      } else {
        print("DEBUG [Check #" + checkCount + "]: Internet ONLINE");
        failCount = 0;
      }
    }
  );
}

print("=== Watchdog mit IP-Test gestartet ===");
Timer.set(CONFIG.pingInterval, true, checkInternet);

// Alle 6 Sekunden ausführen
Timer.set(CONFIG.pingInterval, true, checkInternet);
