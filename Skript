let CONFIG = {
  target: "http://neverssl.com", // Verlässlicher HTTP-Test
  pingInterval: 6000,           // Test-Modus: Alle 6 Sekunden prüfen (6000 ms)
  failThreshold: 10,            // Test-Modus: Nach 10 Fehlschlägen (60 Sek.) Neustart
  powerOffDuration: 15000       // Strom für 15 Sekunden trennen
};

let checkCount = 0; // Gesamtzahl aller durchgeführten Checks
let failCount = 0;  // Zähler für aufeinanderfolgende Fehlschläge

function checkInternet() {
  checkCount++; // Gesamtzähler bei jedem Durchlauf erhöhen
  
  Shelly.call(
    "HTTP.GET",
    { url: CONFIG.target, timeout: 3 },
    function (result, error_code) {
      if (error_code !== 0) {
        failCount++;
        print("DEBUG [Check #" + checkCount + "]: Internet OFFLINE (" + failCount + "/" + CONFIG.failThreshold + " Fehlschläge)");
        
        // Schwellenwert erreicht -> Neustart
        if (failCount >= CONFIG.failThreshold) {
          print(">>> DEBUG: Schwellenwert erreicht! Führe Neustart der FRITZ!Box aus... <<<");
          failCount = 0; // Zähler für die nächsten Durchläufe zurücksetzen
          
          // Strom kurz kappen
          Shelly.call("Switch.Set", { id: 0, on: false });
          Timer.set(CONFIG.powerOffDuration, false, function() {
            Shelly.call("Switch.Set", { id: 0, on: true });
            print(">>> DEBUG: Strom wieder EINGESCHALTET. Zähler läuft weiter. <<<");
          });
        }
      } else {
        // Internet ist da -> Zähler für Fehlschläge zurücksetzen
        print("DEBUG [Check #" + checkCount + "]: Internet ONLINE");
        failCount = 0;
      }
    }
  );
}

// Skript-Start im Log anzeigen
print("=== Watchdog-Testmodus gestartet (Intervall: 6s) ===");

// Alle 6 Sekunden ausführen
Timer.set(CONFIG.pingInterval, true, checkInternet);
